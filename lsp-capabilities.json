{
  "schema": "OpenQCLspCapabilities",
  "version": 1,
  "id": "vasp-lsp",
  "software": "vasp",
  "displayName": "VASP",
  "languageId": "vasp",
  "executable": "vasp-lsp",
  "defaultBranch": "main",
  "releaseVersion": "0.4.5",
  "filePatterns": [
    "INCAR",
    "INCAR.*",
    "INCAR_*",
    "POSCAR",
    "POSCAR.*",
    "POSCAR_*",
    "CONTCAR",
    "CONTCAR.*",
    "CONTCAR_*",
    "KPOINTS",
    "KPOINTS.*",
    "KPOINTS_*",
    "POTCAR",
    "OUTCAR",
    "OSZICAR",
    "STDOUT",
    "STDERR",
    "vasp.out",
    "vasp.err",
    "slurm-*.out",
    "slurm-*.err",
    "*.log"
  ],
  "maturity": "preview",
  "featureScope": {
    "coreEditor": [
      "diagnostics",
      "completion",
      "hover",
      "document-formatting",
      "document-symbols",
      "code-actions",
      "document-sync"
    ],
    "workspaceDiagnostics": {
      "status": "available",
      "scope": "calculation-directory",
      "overlayPrecedence": "open-buffer-before-disk",
      "notes": "Recognized neighboring inputs are used for cross-file checks; binary restart files are checked by existence only."
    },
    "openBufferNavigation": {
      "status": "experimental",
      "definition": "current-open-document",
      "references": "current-open-document",
      "workspaceSymbols": "open-INCAR-documents-only",
      "rename": "open-INCAR-documents-only",
      "diskScan": false
    },
    "runtimeLogs": {
      "status": "available",
      "scope": "selected-failure-patterns",
      "completeInterpreter": false
    }
  },
  "blockingPolicy": {
    "mode": "blocking-errors",
    "description": "High-confidence errors can stop agent run-gates; warnings are advisory with confidence and manual references."
  },
  "capabilities": [
    "agent-envelope",
    "agent-json-cli",
    "completion",
    "diagnostic-engine-v1",
    "diagnostics",
    "document-formatting",
    "document-symbols",
    "fix-preview",
    "hover",
    "manifest",
    "openqc-context",
    "output-log-diagnostics",
    "rich-diagnostics",
    "routing",
    "source-provenance",
    "symbols"
  ],
  "agentCli": {
    "command": "vasp-lsp-tool",
    "operations": [
      "check",
      "context",
      "complete",
      "hover",
      "symbols",
      "fix",
      "rules",
      "describe",
      "schema",
      "schema-audit",
      "section",
      "examples",
      "next-tokens",
      "explain"
    ],
    "jsonFormat": true,
    "failOnBlocking": true,
    "primary": true,
    "jsonEnvelope": "DiagnosticEnvelope/v1",
    "genericFallback": {
      "status": "available",
      "usedWhen": "No optional module-level provider hook is available",
      "operations": ["complete", "hover", "symbols", "fix"],
      "notEquivalentToNativeProviders": true
    }
  },
  "diagnosticSchema": "rules/diagnostics.yaml",
  "validationBackends": [
    {
      "id": "vasp-lsp-tool-static",
      "kind": "open_source",
      "mode": "static",
      "status": "available",
      "operations": [
        "check",
        "context",
        "complete",
        "hover",
        "symbols",
        "fix",
        "rules"
      ],
      "command": [
        "vasp-lsp-tool",
        "check"
      ],
      "notes": "Local INCAR/POSCAR/KPOINTS parser and DiagnosticEnvelope/v1 checks."
    },
    {
      "id": "vasp-log-parser",
      "kind": "open_source",
      "mode": "log",
      "status": "available",
      "operations": [
        "explain"
      ],
      "command": [
        "vasp-lsp-explain"
      ],
      "notes": "Runtime log diagnostics via vasp-lsp-explain / PLAN24 explain envelope."
    }
  ],
  "jsonEnvelopes": [
    {
      "id": "DiagnosticEnvelope/v1",
      "commands": [
        "vasp-lsp-tool check",
        "vasp-lsp-tool context",
        "vasp-lsp-tool complete",
        "vasp-lsp-tool hover",
        "vasp-lsp-tool symbols",
        "vasp-lsp-tool fix"
      ],
      "requiredTopLevelFields": [
        "operation",
        "uri",
        "diagnostics",
        "summary",
        "capabilities"
      ]
    },
    {
      "id": "vasp-lsp.plan24.v1",
      "commands": ["vasp-lsp-check", "vasp-lsp-explain"],
      "requiredTopLevelFields": [
        "schema_version",
        "source",
        "diagnostics",
        "summary"
      ]
    }
  ],
  "wikiPaths": {
    "rawAssets": "raw/assets",
    "entities": "wiki/entities",
    "concepts": "wiki/concepts",
    "synthesis": "wiki/synthesis",
    "index": "wiki/entities/VASP_LSP.md"
  },
  "fixturePaths": {
    "valid": [
      "tests/fixtures/valid"
    ],
    "invalid": [
      "tests/fixtures/invalid"
    ],
    "logs": [
      "tests/fixtures/logs"
    ]
  },
  "outputLogPatterns": [
    "OUTCAR",
    "vasp.out",
    "*.out",
    "slurm-*.out"
  ],
  "openqc": {
    "registryId": "vasp-lsp",
    "repoName": "VASP-LSP",
    "contextContract": "DSLAuthoringContext",
    "diagnosticEnvelope": "DiagnosticEnvelope/v1"
  },
  "compatibility": {
    "agentLspWrapper": {
      "module": "vasp_lsp.agent_lsp",
      "class": "AgentLSP",
      "status": "compatibility-wrapper",
      "recommendedForNewIntegrations": false,
      "replacement": "vasp-lsp-tool or the native vasp-lsp --stdio server"
    },
    "richDiagnosticsAdapter": {
      "module": "vasp_lsp.rich_diagnostics",
      "status": "compatibility-and-serialization-layer",
      "newIntegrations": "Use the documented JSON envelopes rather than importing this module directly."
    }
  },
  "sourceProvenance": [
    {
      "kind": "official_docs",
      "label": "VASP manual hub",
      "url": "https://www.vasp.at/wiki/index.php/The_VASP_Manual"
    },
    {
      "kind": "official_docs",
      "label": "INCAR reference",
      "url": "https://www.vasp.at/wiki/index.php/INCAR"
    },
    {
      "kind": "upstream_manifest",
      "label": "Upstream VASP reference links",
      "path": "raw/assets/upstream-vasp-reference.md"
    },
    {
      "kind": "versioned_rules",
      "label": "Diagnostic rule catalog",
      "path": "rules/diagnostics.yaml"
    },
    {
      "kind": "release_version",
      "label": "Release version file",
      "path": "VERSION"
    },
    {
      "kind": "changelog",
      "label": "Project changelog",
      "path": "CHANGELOG.md"
    }
  ]
}
